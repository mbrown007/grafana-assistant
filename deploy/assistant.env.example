# Base app config
ASSISTANT_GRAFANA_URL=http://localhost:3000
ASSISTANT_GRAFANA_TOKEN=glsa_xxx
ASSISTANT_OPENAI_API_KEY=sk-xxx
ASSISTANT_OPENAI_MODEL=gpt-4o
ASSISTANT_DB_PATH=/var/lib/monitoring-assistant/assistant.db
ASSISTANT_KB_PATH=/opt/monitoring-assistant/KB
# ASSISTANT_BASE_PATH=/assistant
# ASSISTANT_KB_MAX_SECTIONS=2
# ASSISTANT_KB_MAX_SECTION_CHARS=2000

# MCP stdio servers inherit this environment from the assistant process.
# Add only what your MCP servers need.
ALERTMANAGER_URL=http://localhost:9093
ALERTMANAGER_USERNAME=
ALERTMANAGER_PASSWORD=

GENESYSCLOUD_REGION=us-east-1
GENESYSCLOUD_OAUTHCLIENT_ID=
GENESYSCLOUD_OAUTHCLIENT_SECRET=
