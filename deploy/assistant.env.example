# Base app config
ASSISTANT_GRAFANA_URL=http://localhost:3000
ASSISTANT_GRAFANA_TOKEN=glsa_xxx
ASSISTANT_OPENAI_API_KEY=sk-xxx
ASSISTANT_OPENAI_MODEL=gpt-4o
