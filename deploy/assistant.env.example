# Base app config
ASSISTANT_GRAFANA_URL=http://localhost:3000
ASSISTANT_GRAFANA_TOKEN=glsa_xxx
ASSISTANT_OPENAI_API_KEY=sk-xxx
ASSISTANT_OPENAI_MODEL=gpt-4o
# ASSISTANT_MODEL_PROFILE=balanced
# ASSISTANT_MODEL_PROFILE_DEFAULT=balanced
ASSISTANT_DB_PATH=/var/lib/monitoring-assistant/assistant.db
ASSISTANT_KB_PATH=/opt/monitoring-assistant/KB
# ASSISTANT_BASE_PATH=/assistant
# ASSISTANT_KB_MAX_SECTIONS=2
# ASSISTANT_KB_MAX_SECTION_CHARS=2000
# ASSISTANT_INVESTIGATION_TOOL_TIMEOUT_SECONDS=8
# ASSISTANT_REQUEST_BUDGET_MAX_PROMPT_TOKENS=12000
# ASSISTANT_REQUEST_BUDGET_MAX_COMPLETION_TOKENS=4000
# ASSISTANT_REQUEST_BUDGET_MAX_TOOL_ITERATIONS=5
# ASSISTANT_REQUEST_BUDGET_MAX_TOOL_CALLS=12
# ASSISTANT_REQUEST_BUDGET_MAX_ESTIMATED_COST_USD=0.10
# ASSISTANT_REQUEST_BUDGET_PROMPT_COST_PER_1M_USD=0.80
# ASSISTANT_REQUEST_BUDGET_COMPLETION_COST_PER_1M_USD=3.20
# ASSISTANT_FEATURE_ROUTING_MODE=true
# ASSISTANT_FEATURE_COMPOSITE_TOOL_MODE=true
# ASSISTANT_FEATURE_JUDGE_GATE_MODE=true
# ASSISTANT_FEATURE_EVIDENCE_REDACTION_MODE=true

# MCP stdio servers inherit this environment from the assistant process.
# Add only what your MCP servers need.
ALERTMANAGER_URL=http://localhost:9093
ALERTMANAGER_USERNAME=
ALERTMANAGER_PASSWORD=

GENESYSCLOUD_REGION=us-east-1
GENESYSCLOUD_OAUTHCLIENT_ID=
GENESYSCLOUD_OAUTHCLIENT_SECRET=

# ChatOps bridge (optional). Run `make mattermost-setup` first.
# ASSISTANT_FEATURE_CHATOPS_ENABLED=true
# ASSISTANT_CHATOPS_PROVIDER=mattermost
# ASSISTANT_CHATOPS_BOT_USER_ID=99
# ASSISTANT_CHATOPS_BOT_USER_NAME=assistant-bot
# ASSISTANT_CHATOPS_BOT_ORG_ID=1
# ASSISTANT_CHATOPS_MATTERMOST_URL=http://localhost:18065
# ASSISTANT_CHATOPS_MATTERMOST_TOKEN=<bot-personal-access-token>
# ASSISTANT_CHATOPS_MATTERMOST_TEAM=monitoring

# Optional (make mcp-start): override Grafana MCP read-focused defaults.
# GRAFANA_MCP_ENABLED_TOOLS=search,datasource,prometheus,loki,alerting,dashboard,navigation
# GRAFANA_MCP_EXTRA_FLAGS=--disable-write=false --disable-admin=false
