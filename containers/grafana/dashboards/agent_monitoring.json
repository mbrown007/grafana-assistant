{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "stat",
      "title": "Total Chats",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(increase(monitoring_assistant_chats_started_total[$__range]))",
          "refId": "A"
        }
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "type": "stat",
      "title": "Total Tool Calls",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(increase(monitoring_assistant_tool_calls_total[$__range]))",
          "refId": "A"
        }
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "type": "stat",
      "title": "Total LLM Tokens",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(increase(monitoring_assistant_llm_tokens_total[$__range]))",
          "refId": "A"
        }
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "type": "stat",
      "title": "Total Errors",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(increase(monitoring_assistant_errors_total[$__range]))",
          "refId": "A"
        }
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "type": "barchart",
      "title": "Tool Usage",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum by (tool_name) (increase(monitoring_assistant_tool_calls_total[$__range]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Usage Over Time",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(increase(monitoring_assistant_chats_started_total[$__rate_interval]))",
          "legendFormat": "Chats",
          "refId": "A"
        },
        {
          "expr": "sum(increase(monitoring_assistant_tool_calls_total[$__rate_interval]))",
          "legendFormat": "Tool Calls",
          "refId": "B"
        },
        {
          "expr": "sum(increase(monitoring_assistant_llm_tokens_total[$__rate_interval]))",
          "legendFormat": "LLM Tokens",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Errors Over Time (by source)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum by (source) (increase(monitoring_assistant_errors_total[$__rate_interval]))",
          "legendFormat": "{{source}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Chat Transcript (Loki)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "expr": "{app=\"monitoring-assistant\"} | json | session_id=\"$session_id\"",
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "Recent Scratchpads",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 20},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "expr": "{app=\"monitoring-assistant\"} | json | event=\"tool_call\" | tool_name=\"scratchpad__upsert_panel\"",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "line",
            "fields": ["time", "session_id", "user_id", "dashboard_uid"]
          }
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["monitoring-assistant"],
  "templating": {
    "list": [
      {
        "name": "session_id",
        "label": "Session",
        "type": "query",
        "datasource": {"type": "loki", "uid": "loki"},
        "query": "label_values({app=\"monitoring-assistant\"} | json, session_id)",
        "refresh": 2,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "user_id",
        "label": "User",
        "type": "query",
        "datasource": {"type": "loki", "uid": "loki"},
        "query": "label_values({app=\"monitoring-assistant\"} | json, user_id)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Monitoring Assistant Observability",
  "version": 1
}
