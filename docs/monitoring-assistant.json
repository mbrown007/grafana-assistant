{
  "uid": "monitoring-assistant-dev",
  "title": "Monitoring Assistant (Dev)",
  "tags": ["monitoring-assistant", "dev"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP Requests / s",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(assistant_http_requests_total[5m]))",
          "legendFormat": "req/s",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Request Duration (p95)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(assistant_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "LLM Cost (GBP)",
      "description": "Estimated cost based on GPT-4.1 mini pricing: input £0.63/1M tokens, output £2.53/1M tokens (USD→GBP @ 0.79)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "(sum(assistant_llm_tokens_total{direction=\"prompt\"}) or vector(0)) / 1e6 * 0.80 * 0.79 + (sum(assistant_llm_tokens_total{direction=\"completion\"}) or vector(0)) / 1e6 * 3.20 * 0.79",
          "legendFormat": "Total cost",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyGBP",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 2 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 8
      }
    },
    {
      "type": "timeseries",
      "title": "LLM Cost Over Time (GBP)",
      "description": "Cumulative cost rate based on GPT-4.1 mini pricing",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(assistant_llm_tokens_total{direction=\"prompt\"}[5m])) / 1e6 * 0.80 * 0.79",
          "legendFormat": "Input cost / 5m",
          "refId": "A"
        },
        {
          "expr": "sum(increase(assistant_llm_tokens_total{direction=\"completion\"}[5m])) / 1e6 * 3.20 * 0.79",
          "legendFormat": "Output cost / 5m",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyGBP",
          "decimals": 6,
          "custom": {
            "stacking": { "mode": "normal" },
            "fillOpacity": 30
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 6,
        "y": 8
      }
    },
    {
      "type": "stat",
      "title": "LLM Tokens",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(assistant_llm_tokens_total{direction=\"prompt\"}) or vector(0)",
          "legendFormat": "Input",
          "refId": "A",
          "instant": true
        },
        {
          "expr": "sum(assistant_llm_tokens_total{direction=\"completion\"}) or vector(0)",
          "legendFormat": "Output",
          "refId": "B",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      }
    },
    {
      "type": "stat",
      "title": "Avg Tokens / Chat",
      "description": "Average input and output tokens per chat session",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "(sum(assistant_llm_tokens_total{direction=\"prompt\"}) or vector(0)) / clamp_min(sum(monitoring_assistant_chats_started_total) or vector(1), 1)",
          "legendFormat": "Avg input",
          "refId": "A",
          "instant": true
        },
        {
          "expr": "(sum(assistant_llm_tokens_total{direction=\"completion\"}) or vector(0)) / clamp_min(sum(monitoring_assistant_chats_started_total) or vector(1), 1)",
          "legendFormat": "Avg output",
          "refId": "B",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      }
    },
    {
      "type": "logs",
      "title": "Host Logs (Promtail)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{app=\"monitoring-assistant\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "dedupStrategy": "none",
        "wrapLogMessage": true
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 24
      }
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  }
}
