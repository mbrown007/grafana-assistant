# Monitoring Assistant - Environment Variables
# Copy this to .env and fill in the values

# Required: OpenAI API key
ASSISTANT_OPENAI_API_KEY=sk-xxx

# Required: Grafana service account token
ASSISTANT_GRAFANA_TOKEN=glsa_xxx

# Optional: Override config values
# ASSISTANT_LISTEN_ADDR=:5480
# ASSISTANT_GRAFANA_URL=http://127.0.0.1:3000
# ASSISTANT_DB_PATH=data/assistant.db
